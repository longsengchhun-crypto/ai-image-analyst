{
  "name": "ai-image-analyst-backend",
  "version": "1.0.0",
  "description": "REST API backend for the AI Image Understanding App. Handles image upload, AI vision analysis, visual Q&A, and history persistence backed by Neon Postgres.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
