# Copy this file to .env for local development.
# NEVER commit the real .env file — it is already listed in .gitignore.

# Neon Postgres connection string (Settings -> Connection Details in the Neon console)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Secret used to sign JWTs issued by POST /api/auth/anonymous
JWT_SECRET=change-this-to-a-long-random-string

# Shared app-level API key the Flutter client must send as the "x-api-key" header.
# This is a coarse anti-abuse gate; per-user identity comes from the JWT.
APP_API_KEY=change-this-to-a-long-random-string

# Anthropic API key used for AI vision (description, object listing, OCR summary, VQA).
# Leave blank to run the backend in DEMO MODE (canned, clearly-labeled responses,
# useful for developing/demoing the Flutter app without incurring API costs).
ANTHROPIC_API_KEY=

# Model used for vision + VQA calls
ANTHROPIC_MODEL=claude-fable-5-1

# Port for local dev (Vercel ignores this and assigns its own port)
PORT=8080

# Comma-separated list of allowed CORS origins. Use * for local development only.
CORS_ORIGINS=*
