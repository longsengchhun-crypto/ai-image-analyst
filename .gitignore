# --- Secrets (never commit) ---
.env
.env.local
.env.*.local
backend/.env
*.pem

# --- Node / backend ---
node_modules/
backend/node_modules/
npm-debug.log*
.vercel

# --- Flutter / Dart ---
# android/, web/, and ios/ ARE committed (flutter create was run for all
# three — see README/PROJECT_REPORT). android/ and web/ are verified to
# build successfully in this environment; ios/ is generated scaffolding
# only — it cannot be built or code-signed here (no macOS/Xcode toolchain
# available), so it needs `flutter build ios`/`ipa` run on a Mac before
# first use. macos/linux/windows were never generated.
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/build/
app/macos/
app/linux/
app/windows/
app/.idea/
app/*.iml
app/pubspec.lock

# Android build-time/local-machine files (never portable across machines)
app/android/local.properties
app/android/.gradle/
app/android/.kotlin/
app/android/app/debug
app/android/app/profile
app/android/app/release
app/android/**/build/
app/android/*.iml

# iOS build-time/local-machine files (Xcode regenerates these; never portable)
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/flutter_export_environment.sh

# Web build output (regenerate with `flutter build web`)
app/web/build/

# --- OS ---
.DS_Store
Thumbs.db

